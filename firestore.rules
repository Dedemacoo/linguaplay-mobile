rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── KULLANICI PROFİLLERİ (USERS) ──
    match /users/{userId} {
      allow read: if isSignedIn(); // Sadece giriş yapanlar profilleri görebilir
      allow write: if isOwner(userId); // Sadece kendi verisini değiştirebilir
      
      // Kullanıcının alt koleksiyonları (sessions, progress vs.)
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── DERSLER (LESSONS) ──
    match /lessons_en/{doc=**}  { allow read: if isSignedIn(); allow write: if false; }
    match /lessons_tr/{doc=**}  { allow read: if isSignedIn(); allow write: if false; }
    match /lessons_fr/{doc=**}  { allow read: if isSignedIn(); allow write: if false; }
    match /lessons_de/{doc=**}  { allow read: if isSignedIn(); allow write: if false; }
    match /lessons_es/{doc=**}  { allow read: if isSignedIn(); allow write: if false; }
    match /lessons_it/{doc=**}  { allow read: if isSignedIn(); allow write: if false; }
    match /lessons_ja/{doc=**}  { allow read: if isSignedIn(); allow write: if false; }
    match /lessons_ko/{doc=**}  { allow read: if isSignedIn(); allow write: if false; }
    match /lessons_ar/{doc=**}  { allow read: if isSignedIn(); allow write: if false; }
    match /lessons_ru/{doc=**}  { allow read: if isSignedIn(); allow write: if false; }
    match /lessons_zh/{doc=**}  { allow read: if isSignedIn(); allow write: if false; }
    match /lessons_pt/{doc=**}  { allow read: if isSignedIn(); allow write: if false; }
    match /lessons_nl/{doc=**}  { allow read: if isSignedIn(); allow write: if false; }
    match /lessons_ku/{doc=**}  { allow read: if isSignedIn(); allow write: if false; }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /content/{contentId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /leaderboard/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /battles/{battleId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && (
        resource.data.player1.uid == request.auth.uid ||
        (resource.data.player2 != null && resource.data.player2.uid == request.auth.uid) ||
        resource.data.status == 'waiting'
      );
    }

    match /chats/{chatId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    match /duelRequests/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /friend_requests/{document=**} {
      allow read, write: if isSignedIn();
    }
    
    match /friends/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /conversations/{document=**} {
      allow read, write: if isSignedIn();
    }

    match /leagues/{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
